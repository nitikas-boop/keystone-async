# Copy to .env to override. Every model runs locally through Ollama; nothing leaves the machine.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Extraction runs on the teammate's stronger machine (qwen3:14b); point this at it over the LAN.
EXTRACT_OLLAMA_URL=http://host.docker.internal:11434
ANSWER_MODEL=qwen3:8b
EXTRACT_MODEL=qwen3:14b
# Graphiti defaults to OpenAI embeddings; this overrides it with a local model.
EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
# Graphiti core sends PostHog telemetry unless this is false (hardcoded in docker-compose.yml).
GRAPHITI_TELEMETRY_ENABLED=false
# Team model decision: qwen2.5:7b for extraction + reasoning, with a 16k context (Ollama defaults to 4096 and
# silently truncates longer prompts). Create it with scripts/create_models.sh, then uncomment. config.py already
# reads ANSWER_MODEL/EXTRACT_MODEL; OLLAMA_NUM_CTX is NOT read by config.py yet. See docs/16k_context_for_hemanth.md.
# ANSWER_MODEL=qwen2.5-7b-16k
# EXTRACT_MODEL=qwen2.5-7b-16k
# OLLAMA_NUM_CTX=16384
