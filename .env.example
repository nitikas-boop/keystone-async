# Copy to .env to override. Every model runs locally through Ollama; nothing leaves the machine.
OLLAMA_BASE_URL=http://host.docker.internal:11434
EXTRACT_OLLAMA_URL=http://host.docker.internal:11434
# Team model for answering and extraction: qwen2.5:7b with a 16k context window.
# Ollama's default 4k context silently drops the start of long prompts. Create the model once per machine:
#   sh scripts/create_models.sh   (pulls qwen2.5:7b, creates qwen2.5-7b-16k; see docs/MODEL-CONTEXT.md)
ANSWER_MODEL=qwen2.5-7b-16k
EXTRACT_MODEL=qwen2.5-7b-16k
# Graphiti defaults to OpenAI embeddings; this overrides it with a local model.
EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768
# Graphiti core sends PostHog telemetry unless this is false (hardcoded in docker-compose.yml).
GRAPHITI_TELEMETRY_ENABLED=false

# Refusal cut-off on retrieval cosine (default 0.80). Lower slightly (e.g. 0.78) if on-topic demo questions are refused on this machine.
# RELEVANCE_MIN=0.80

# --- P1 --- (access, identity, comms)
# Session signing key. Unset: random per backend start (a restart signs everyone out).
# JWT_SECRET=
# An empty database gets the synthetic Nimbus Ledger org and demo users (employee IDs NL-000 .. NL-008, AUD-001),
# all with this password, joinable with this code. Demo only: set DEMO_SEED=0 for a real deployment.
DEMO_SEED=1
DEMO_PASSWORD=nimbus-demo-2026
DEMO_JOIN_CODE=NMBL-7K2Q
# One-click sign-in buttons for the demo accounts on the sign-in screen (defaults to DEMO_SEED).
# DEMO_LOGIN=1
# Browser origins allowed to call the API with the session cookie. For a phone on the LAN add the laptop's address,
# e.g. http://(localhost|127\.0\.0\.1|192\.168\.1\.20)(:\d+)?
# CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?
# Dev and tests only: sign in with an X-User header. Never set on a real deployment.
# KEYSTONE_DEV_AUTH=1
